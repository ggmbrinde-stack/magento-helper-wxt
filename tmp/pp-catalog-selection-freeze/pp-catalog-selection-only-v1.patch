 import { ppCatalogEntity, PpCatalogResponseSchema, type PpCatalogResponse } from '../../../shared/ppCatalog';
+import { PpCatalogIndexPageSchema, type PpCatalogIndexRow } from '../../../shared/ppCatalog';
 
