+def implementation_sha():
+    root=Path(__file__).resolve().parent
+    names=['batch_plan.py','excel_proof.py','catalog_names.py','batch_apply.py','batch_cli.py','session_bridge.js','rendered_layout.py','format_layout.py']
+    return r.digest({n:hashlib.sha256((root/n).read_bytes()).hexdigest() for n in names})
