diff --git a/src/dashboard/sections/ui/PpPreview.tsx b/src/dashboard/sections/ui/PpPreview.tsx
new file mode 100644
index 0000000..852edfb
--- /dev/null
+++ b/src/dashboard/sections/ui/PpPreview.tsx
@@ -0,0 +1,121 @@
+import { h, Fragment } from 'preact';
+import { useEffect, useRef, useState } from 'preact/hooks';
+import type { PpPreviewTab, ReadPpPreviewDraftResponse } from '../../../core/messages';
+import { PP_CATALOG_DATABASE, type PpCatalogResponse } from '../../../shared/ppCatalog';
+import { attributeSetConsistency, isPpPreviewTab, ppPreviewRows, readPreviewResponses } from './ppPreviewModel';
+
+const show = (value: unknown): string => value === undefined || value === null ? 'Unknown / not supplied' : JSON.stringify(value, null, 2);
+const time = (value: string | number | undefined | null): string => value == null ? 'Unknown' : new Date(value).toLocaleString();
+
+export function PpPreview() {
+  const [tabs, setTabs] = useState<PpPreviewTab[]>([]);
+  const [selectedToken, setSelectedToken] = useState('');
+  const [code, setCode] = useState('');
+  const [paired, setPaired] = useState(false);
+  const [busy, setBusy] = useState(false);
+  const [notice, setNotice] = useState('List open PP tabs, then choose one and enter the exact Notion business code.');
+  const [result, setResult] = useState<{ desired: PpCatalogResponse; current: ReadPpPreviewDraftResponse } | null>(null);
+  const generation = useRef(0);
+  useEffect(() => () => { generation.current++; }, []);
+  const selected = tabs.find(tab => tab.selectionToken === selectedToken);
+
+  const invalidate = (): void => {
+    generation.current++;
+    setResult(null);
+    setPaired(false);
+    setBusy(false);
+    setNotice('Selection changed. Read both sources again; the previous preview is stale.');
+  };
+  const listTabs = async (): Promise<void> => {
+    invalidate();
+    setTabs([]); setSelectedToken(''); setBusy(true);
+    const request = generation.current;
+    try {
+      const response = await chrome.runtime.sendMessage({ type: 'LIST_PP_PREVIEW_TABS' });
+      if (request !== generation.current) return;
+      if (!response?.ok || !Array.isArray(response.tabs) || !response.tabs.every(isPpPreviewTab)) throw new Error('Cannot list supported PP tabs. Retry explicitly.');
+      setTabs(response.tabs);
+      setNotice(response.tabs.length ? 'Choose an existing Magento PP edit tab. No tab is selected automatically.' : 'No supported PP edit tabs found. Open one yourself, then list tabs again.');
+    } catch {
+      if (request === generation.current) setNotice('Cannot list supported PP tabs. Retry explicitly.');
+    } finally { if (request === generation.current) setBusy(false); }
+  };
+  const read = async (): Promise<void> => {
+    if (!selected || !paired || !code.trim() || code.length > 128) return;
+    const request = ++generation.current;
+    setResult(null); setBusy(true); setNotice('Reading the manually paired sources…');
+    try {
+      const [desired, current] = await Promise.all([
+        chrome.runtime.sendMessage({ type: 'FETCH_PP_PREVIEW_CATALOG', code }),
+        chrome.runtime.sendMessage({ type: 'READ_PP_PREVIEW_DRAFT', tabId: selected.tabId, selectionToken: selected.selectionToken }),
+      ]);
+      if (request !== generation.current) return;
+      setResult(readPreviewResponses(code, selected, desired, current));
+      setNotice('Manual pairing only. The PP association is not verified. These are timed snapshots; changes in either source require a new read.');
+    } catch (error) {
+      if (request === generation.current) setNotice(error instanceof Error ? error.message : 'The sources could not be read. Retry explicitly.');
+    } finally { if (request === generation.current) setBusy(false); }
+  };
+  const desired = result?.desired;
+  const current = result?.current;
+  const draft = current?.ok ? current.snapshot : null;
+  const usableDraft = draft && ['ok', 'partial'].includes(draft.status) ? draft : null;
+  const rows = desired && usableDraft ? ppPreviewRows(desired, usableDraft) : [];
+
+  return <div class="db-stack">
+    <section class="db-card">
+      <h2>PP Preview <span class="db-badge">Read-only</span></h2>
+      <p class="db-note">Notion V2 is the desired-definition source. Magento is the current open draft, including unsaved edits, not a saved-server snapshot.</p>
+      <div class="db-actions"><button type="button" class="db-btn" disabled={busy} onClick={() => void listTabs()}>List open PP tabs</button></div>
+      <label class="db-field"><span>Magento PP edit tab</span>
+        <select value={selectedToken} onChange={event => { invalidate(); setSelectedToken(event.currentTarget.value); }}>
+          <option value="">Select a tab explicitly</option>
+          {tabs.map(tab => <option key={tab.selectionToken} value={tab.selectionToken}>{tab.host} · entity {tab.entityId} · tab {tab.tabId}</option>)}
+        </select>
+      </label>
+      <label class="db-field"><span>Exact Notion business PP code</span>
+        <input value={code} maxLength={128} autoComplete="off" onInput={event => { invalidate(); setCode(event.currentTarget.value); }} />
+        <em>Exact text, including zeros and spaces. No aliases and no code derived from the Magento entity or Attribute Set ID.</em>
+      </label>
+      <label><input type="checkbox" checked={paired} disabled={!selected || !code.trim()} onChange={event => { generation.current++; setResult(null); setBusy(false); setPaired(event.currentTarget.checked); setNotice('Manual pairing changed. Read both sources again.'); }} /> I manually pair this code with this tab for this preview. This does not verify their association.</label>
+      <div class="db-actions"><button type="button" class="db-btn db-btn--primary" disabled={busy || !paired || !selected || !code.trim()} aria-busy={busy} onClick={() => void read()}>{busy ? 'Reading…' : 'Read paired preview'}</button></div>
+      <p role="status" aria-live="polite">{notice}</p>
+    </section>
+    {result ? <>
+      <div class="db-grid">
+        <section class="db-card"><h2>Current: Magento draft</h2>
+          {selected ? <p>{selected.host} · entity {selected.entityId} · tab {selected.tabId}</p> : null}
+          <p>Status: {draft?.status ?? 'unavailable'}. Scanned: {time(draft?.scannedAt)}</p>
+          {current && !current.ok ? <p role="alert">{current.reason}</p> : null}
+          {draft?.warnings.map((warning, i) => <p class="db-note" key={i}>{warning}</p>)}
+          {usableDraft ? <>
+            <p>Provider entity ID: {show(usableDraft.providerEntityId)}</p>
+            <p>Provider Attribute Set ID: {show(usableDraft.providerAttributeSetId)}</p>
+            <p>General Attribute Set IDs: {show(usableDraft.generalAttributeSetId)}</p>
+            <p>Native Attribute Set consistency: {attributeSetConsistency(usableDraft)}. This does not verify a Notion association.</p>
+            <p>Locations: {usableDraft.locations.state}, {usableDraft.locations.rows.length} read. Items: {usableDraft.items.state}, {usableDraft.items.rows.length} read. Missing collections are not empty lists.</p>
+            <details><summary>Current draft reference</summary><pre class="db-pp-data">{show(usableDraft)}</pre></details>
+          </> : <p role="alert">No usable current draft. Comparison is blocked.</p>}
+        </section>
+        <section class="db-card"><h2>Desired: Notion PP Catalog V2</h2>
+          <p>Business code: {desired?.code}. Status: {desired?.status}</p>
+          <p>Read: {time(desired?.checkedAt)}. Edited: {time(desired?.definition?.lastEditedAt)}</p>
+          <p>{desired?.reason}</p>
+          <p class="db-note">Source database: {PP_CATALOG_DATABASE}</p>
+          {desired?.definition ? <>
+            <p>Notion page ID: {desired.definition.pageId}</p>
+            <p>Review status: {desired.definition.reviewStatus ?? 'Unknown'}. A rever, partial or missing data needs manual review.</p>
+            {desired.definition.warnings.map((warning, i) => <p class="db-note" key={i}>{warning}</p>)}
+            <details><summary>Desired definition and body reference</summary><pre class="db-pp-data">{show(desired.definition)}</pre></details>
+          </> : <p>No unique desired definition. Comparison is blocked.</p>}
+        </section>
+      </div>
+      {rows.length ? <section class="db-card"><h2>Side-by-side reference</h2>
+        <p class="db-note">No verified native-field mapping is available. These rows explain the blockers; they are not executable changes. Blank desired values never request removal.</p>
+        <div class="db-table-wrap"><table class="db-table"><thead><tr><th scope="col">Field</th><th scope="col">Current draft</th><th scope="col">Desired reference</th><th scope="col">Comparison</th></tr></thead><tbody>
+          {rows.map(row => <tr key={row.field}><th scope="row">{row.field}</th><td><pre class="db-pp-data">{show(row.current)}</pre></td><td><pre class="db-pp-data">{show(row.desired)}</pre></td><td>Blocked: {row.reason}</td></tr>)}
+        </tbody></table></div>
+      </section> : null}
+    </> : null}
+  </div>;
+}
diff --git a/src/dashboard/sections/ui/ppPreviewModel.ts b/src/dashboard/sections/ui/ppPreviewModel.ts
new file mode 100644
index 0000000..09b1083
--- /dev/null
+++ b/src/dashboard/sections/ui/ppPreviewModel.ts
@@ -0,0 +1,64 @@
+import type { PpPreviewTab, ScanPpDraftResponse, ReadPpPreviewDraftResponse } from '../../../core/messages';
+import { ppCatalogEntity, PpCatalogResponseSchema, type PpCatalogResponse } from '../../../shared/ppCatalog';
+
+export function isPpPreviewTab(value: unknown): value is PpPreviewTab {
+  if (!value || typeof value !== 'object') return false;
+  const tab = value as PpPreviewTab;
+  return Number.isInteger(tab.tabId) && tab.tabId >= 0 && typeof tab.host === 'string' &&
+    typeof tab.entityId === 'string' && /^\d+$/.test(tab.entityId) &&
+    tab.routePath === `/toogas_attributesetcustomoptions/attributesetcustomoptions/edit/attributesetcustomoptions_id/${tab.entityId}` &&
+    ppCatalogEntity(`https://${tab.host}${tab.routePath}`) === tab.entityId &&
+    typeof tab.selectionToken === 'string' && /^[a-f0-9]{64}$/.test(tab.selectionToken);
+}
+
+export function readPreviewResponses(code: string, selected: PpPreviewTab, rawDesired: unknown, rawCurrent: unknown): {
+  desired: PpCatalogResponse; current: ReadPpPreviewDraftResponse;
+} {
+  const parsed = PpCatalogResponseSchema.safeParse(rawDesired);
+  if (!parsed.success || parsed.data.code !== code ||
+    (parsed.data.definition && parsed.data.definition.code !== code)) throw new Error('The Notion response does not match the exact business code. Read again.');
+  const current = rawCurrent as ReadPpPreviewDraftResponse | null;
+  if (!current || typeof current.ok !== 'boolean') throw new Error('The draft response is invalid. Read again.');
+  if (!current.ok) {
+    if (typeof current.reason !== 'string') throw new Error('The draft response is invalid. Read again.');
+  } else {
+    const draft = current.snapshot;
+    if (!isPpPreviewTab(current.tab) || current.tab.tabId !== selected.tabId ||
+      current.tab.selectionToken !== selected.selectionToken || current.tab.entityId !== selected.entityId ||
+      current.tab.host !== selected.host || !draft || draft.version !== 1 ||
+      draft.entityId !== selected.entityId || draft.routePath !== selected.routePath ||
+      !['ok', 'partial', 'unavailable', 'identity-mismatch'].includes(draft.status) ||
+      !draft.general || typeof draft.general !== 'object' || Array.isArray(draft.general) ||
+      !Array.isArray(draft.warnings) || !draft.warnings.every(w => typeof w === 'string') ||
+      ![draft.locations, draft.items].every(c => c && ['available', 'missing', 'invalid'].includes(c.state) && Array.isArray(c.rows))) {
+      throw new Error('The draft response does not match the selected tab. List tabs and select it again.');
+    }
+  }
+  return { desired: parsed.data, current };
+}
+
+export function attributeSetConsistency(draft: ScanPpDraftResponse): 'matching' | 'different' | 'unknown' {
+  const provider = draft.providerAttributeSetId;
+  const general = draft.generalAttributeSetId;
+  const isId = (id: unknown): id is string | number =>
+    (typeof id === 'string' && /^\d+$/.test(id)) || (typeof id === 'number' && Number.isInteger(id) && id >= 0);
+  if (!isId(provider) || !Array.isArray(general) || !general.length || !general.every(isId)) return 'unknown';
+  return general.length === 1 && String(general[0]) === String(provider) ? 'matching' : 'different';
+}
+
+/** Reference rows only: the V2 global lists do not define native field assignments. */
+export function ppPreviewRows(desired: PpCatalogResponse, current: ScanPpDraftResponse) {
+  const definition = desired.definition;
+  if (!definition || !['found', 'partial'].includes(desired.status) || !['ok', 'partial'].includes(current.status)) return [];
+  return [
+    { field: 'Titles', current: current.general.option_title, desired: definition.name,
+      reason: 'The Notion PP title is not an established mapping to the Magento general title.' },
+    { field: 'Locations / faces', current: current.locations, desired: { faces: definition.faces,
+      faceCount: definition.faceCount, locationCount: definition.locationCount },
+      reason: 'Global faces and possible-location counts do not identify Magento location rows or their translations.' },
+    { field: 'Options / techniques', current: current.items, desired: { options: definition.options, techniques: definition.techniques },
+      reason: 'No per-location assignment or Magento catalogue ID mapping is established. Raw parent values are not Notion assignments.' },
+    { field: 'Other general fields / translations', current: { general: current.general, translations: current.generalTranslations },
+      desired: undefined, reason: 'No supported desired native-field mapping. Missing or blank values never request deletion.' },
+  ];
+}
