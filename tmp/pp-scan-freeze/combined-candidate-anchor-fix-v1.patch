+import type {
+  ScanPpDraftRequest,
+  ScanPpDraftResponse,
+} from '../../../core/messages';
+import { ppEntityIdFromUrl } from './page';
+
+const ANCHOR_SELECTOR =
+  '[data-bind*="toogas_attributesetcustomoptions_attributesetcustomoptions_form.areas"]';
+const PANEL_ID = 'mhx-pp-draft-scan';
+
+let mounted:
+  | { panel: HTMLElement; anchor: HTMLElement; host: HTMLElement; entityId: string; destroy: () => void }
+  | undefined;
+
+function isScanResponse(value: unknown): value is ScanPpDraftResponse {
+  if (!value || typeof value !== 'object') return false;
+  const result = value as ScanPpDraftResponse;
+  return (
+    result.version === 1 &&
+    ['ok', 'partial', 'unavailable', 'identity-mismatch'].includes(result.status) &&
+    (typeof result.entityId === 'string' || result.entityId === null) &&
+    typeof result.routePath === 'string' &&
+    !!result.general && typeof result.general === 'object' &&
+    !!result.locations && Array.isArray(result.locations.rows) && Array.isArray(result.locations.skippedPositions) &&
+    !!result.items && Array.isArray(result.items.rows) && Array.isArray(result.items.skippedPositions) &&
+    Array.isArray(result.warnings)
+  );
+}
+
+export function unmountPpScan(): void {
+  mounted?.destroy();
+  mounted = undefined;
+}
+
+export function mountPpScan(): void {
+  const entityId = ppEntityIdFromUrl(window.location.href);
+  const anchor = document.querySelector<HTMLElement>(ANCHOR_SELECTOR);
+  if (
+    mounted &&
+    (!mounted.panel.isConnected || mounted.entityId !== entityId ||
+      mounted.anchor !== anchor || !anchor || mounted.panel.parentElement !== mounted.host ||
+      anchor.parentElement !== mounted.host)
+  ) unmountPpScan();
+  if (!entityId || !anchor?.parentElement || mounted) return;
+
+  const pageDocument = document;
+  const routePath = window.location.pathname;
+  let generation = 0;
+  const panel = document.createElement('section');
+  panel.id = PANEL_ID;
+  panel.setAttribute('aria-label', 'Current Magento custom-option draft scan');
+  const heading = document.createElement('h2');
+  heading.textContent = 'Current Magento draft (read-only)';
+  const explanation = document.createElement('p');
+  explanation.textContent =
+    'Scans the current unsaved draft. It does not save or change Magento data.';
+  const scanButton = document.createElement('button');
+  scanButton.type = 'button';
+  scanButton.textContent = 'Scan current PP';
+  const status = document.createElement('p');
+  status.setAttribute('role', 'status');
+  status.setAttribute('aria-live', 'polite');
+  status.textContent = 'Scan when the custom-option form has finished loading.';
+  const details = document.createElement('details');
+  const summary = document.createElement('summary');
+  summary.textContent = 'Snapshot';
+  const output = document.createElement('pre');
+  output.setAttribute('aria-label', 'Current custom-option draft snapshot');
+  details.append(summary, output);
+  panel.append(heading, explanation, scanButton, status, details);
+  const host = anchor.parentElement;
+  const catalogPanel = host.querySelector<HTMLElement>(':scope > #mhx-pp-catalog');
+  host.insertBefore(panel, catalogPanel ?? anchor);
+
+  const stillCurrent = (request: number): boolean =>
+    request === generation && pageDocument === document && panel.isConnected &&
+    anchor.isConnected && document.querySelector(ANCHOR_SELECTOR) === anchor &&
+    window.location.pathname === routePath &&
+    ppEntityIdFromUrl(window.location.href) === entityId;
+  const onDraftChange = (): void => {
+    generation += 1;
+    scanButton.disabled = false;
+    output.textContent = '';
+    status.textContent = 'The draft changed. Scan again to refresh the snapshot.';
+  };
+  const scan = async (): Promise<void> => {
+    const request = ++generation;
+    scanButton.disabled = true;
+    output.textContent = '';
+    status.textContent = 'Reading the current unsaved Magento draft…';
+    try {
+      const payload: ScanPpDraftRequest = { type: 'SCAN_PP_DRAFT' };
+      const response: unknown = await chrome.runtime.sendMessage(payload);
+      if (!stillCurrent(request)) return;
+      if (!isScanResponse(response) || response.entityId !== entityId || response.routePath !== routePath) {
+        status.textContent = 'The scan response was invalid or the page identity changed. Scan again.';
+        return;
+      }
+      status.textContent = `${response.status}: snapshot of Magento entity ${entityId}. Item parent values remain raw; no Notion or location assignment is inferred.`;
+      output.textContent = JSON.stringify(response, null, 2);
+      details.open = true;
+    } catch {
+      if (!stillCurrent(request)) return;
+      status.textContent = 'The scan could not complete. Retry after Magento has finished loading.';
+    } finally {
+      if (stillCurrent(request)) scanButton.disabled = false;
+    }
+  };
+  const onClick = (): void => { void scan(); };
+  scanButton.addEventListener('click', onClick);
+  anchor.addEventListener('input', onDraftChange, true);
+  anchor.addEventListener('change', onDraftChange, true);
+
+  mounted = {
+    panel,
+    anchor,
+    host,
+    entityId,
+    destroy: () => {
+      generation += 1;
+      scanButton.removeEventListener('click', onClick);
+      anchor.removeEventListener('input', onDraftChange, true);
+      anchor.removeEventListener('change', onDraftChange, true);
+      panel.remove();
+    },
+  };
+}
diff --git a/src/page/features/pp-scan/page.ts b/src/page/features/pp-scan/page.ts
new file mode 100644
index 0000000..b63dd4d
--- /dev/null
+++ b/src/page/features/pp-scan/page.ts
@@ -0,0 +1,347 @@
+import type {
+  PpDraftCollection,
+  PpDraftRow,
+  PpDraftTranslation,
+  PpDraftValue,
+  ScanPpDraftResponse,
+} from '../../../core/messages';
+
+const ROUTE =
+  /\/toogas_attributesetcustomoptions\/attributesetcustomoptions\/edit\/attributesetcustomoptions_id\/(\d+)(?:\/|$)/i;
+export function ppEntityIdFromUrl(url: string): string | null {
+  try {
+    return new URL(url).pathname.match(ROUTE)?.[1] ?? null;
+  } catch {
+    return null;
+  }
+}
+
+/** Runs in Magento's main world and reads only the already-loaded registry provider. */
+export function scanCurrentPpDraft(): ScanPpDraftResponse {
+  const providerName =
+    'toogas_attributesetcustomoptions_attributesetcustomoptions_form.attributesetcustomoptions_form_data_source';
+  const registryModuleName = 'Magento_Ui/js/lib/registry/registry';
+  const maxRows = 100;
+  const maxString = 1024;
+  const maxObjectKeys = 40;
+  const route = window.location.pathname.match(
+    /\/toogas_attributesetcustomoptions\/attributesetcustomoptions\/edit\/attributesetcustomoptions_id\/(\d+)(?:\/|$)/i,
+  );
+  const entityId = route?.[1] ?? null;
+  const base: ScanPpDraftResponse = {
+    version: 1,
+    status: 'unavailable',
+    entityId,
+    routePath: window.location.pathname.slice(0, 512),
+    general: {},
+    locations: { state: 'missing', rows: [], truncated: false, identifierGaps: 0, skippedPositions: [] },
+    items: { state: 'missing', rows: [], truncated: false, identifierGaps: 0, skippedPositions: [] },
+    warnings: [],
+  };
+  if (!entityId) {
+    base.warnings.push('This is not a recognized custom-option edit route.');
+    return base;
+  }
+
+  let clipped = false;
+  let sanitized = false;
+  type Read = { found: boolean; value?: unknown };
+  const read = (source: unknown, key: string): Read => {
+    if (
+      source === null ||
+      (typeof source !== 'object' && typeof source !== 'function')
+    ) return { found: false };
+    const descriptor = Object.getOwnPropertyDescriptor(source, key);
+    if (descriptor && !('value' in descriptor)) sanitized = true;
+    return descriptor && 'value' in descriptor
+      ? { found: true, value: descriptor.value }
+      : { found: false };
+  };
+  const path = (source: unknown, keys: string[]): Read => {
+    let current = source;
+    for (const key of keys) {
+      const next = read(current, key);
+      if (!next.found) return { found: false };
+      current = next.value;
+    }
+    return { found: true, value: current };
+  };
+  const safeValue = (
+    value: unknown,
+    seen = new Set<object>(),
+    depth = 0,
+  ): PpDraftValue => {
+    if (value === null || typeof value === 'boolean') return value;
+    if (typeof value === 'number') {
+      if (!Number.isFinite(value)) sanitized = true;
+      return Number.isFinite(value) ? value : null;
+    }
+    if (typeof value === 'string') {
+      if (value.length > maxString) clipped = true;
+      return value.slice(0, maxString);
+    }
+    if (typeof value !== 'object') {
+      sanitized = true;
+      return null;
+    }
+    if (seen.has(value)) {
+      sanitized = true;
+      return '[Circular]';
+    }
+    if (depth >= 4) {
+      clipped = true;
+      return '[Depth limit]';
+    }
+    seen.add(value);
+    if (Array.isArray(value)) {
+      const out: PpDraftValue[] = [];
+      const length = Math.min(value.length, maxRows);
+      if (value.length > length) clipped = true;
+      for (let index = 0; index < length; index += 1) {
+        const item = read(value, String(index));
+        out.push(item.found ? safeValue(item.value, seen, depth + 1) : null);
+      }
+      seen.delete(value);
+      return out;
+    }
+    const out: Record<string, PpDraftValue> = {};
+    const keys: string[] = [];
+    for (const key in value) {
+      if (!Object.prototype.hasOwnProperty.call(value, key)) continue;
+      keys.push(key);
+      if (keys.length > maxObjectKeys) break;
+    }
+    if (keys.length > maxObjectKeys) clipped = true;
+    for (const key of keys.slice(0, maxObjectKeys)) {
+      const item = read(value, key);
+      if (item.found) out[key.slice(0, 80)] = safeValue(item.value, seen, depth + 1);
+    }
+    seen.delete(value);
+    return out;
+  };
+  const fieldValues = (
+    source: unknown,
+    fields: string[],
+  ): Record<string, PpDraftValue> => {
+    const values: Record<string, PpDraftValue> = {};
+    for (const field of fields) {
+      const found = read(source, field);
+      if (found.found) values[field] = safeValue(found.value);
+    }
+    return values;
+  };
+  const translation = (value: unknown): PpDraftTranslation => {
+    const result: PpDraftTranslation = { raw: safeValue(value) };
+    if (typeof value !== 'string' || !value.trim()) return result;
+    if (value.length > maxString) {
+      clipped = true;
+      result.parseError = 'Translation JSON exceeds the scan limit.';
+      return result;
+    }
+    const trimmed = value.trim();
+    if (!trimmed.startsWith('{') && !trimmed.startsWith('[')) return result;
+    try {
+      result.parsed = safeValue(JSON.parse(value));
+    } catch {
+      result.parseError = 'Invalid translation JSON.';
+    }
+    return result;
+  };
+  const collection = (
+    found: Read,
+    fields: string[],
+    translatedFields: string[],
+    identifierFields: string[],
+  ): PpDraftCollection => {
+    if (!found.found || found.value === null || found.value === undefined) {
+      return { state: 'missing', rows: [], truncated: false, identifierGaps: 0, skippedPositions: [] };
+    }
+    if (!Array.isArray(found.value) && typeof found.value !== 'object') {
+      return { state: 'invalid', rows: [], truncated: false, identifierGaps: 0, skippedPositions: [] };
+    }
+    const source = found.value as object;
+    const keys: string[] = [];
+    if (Array.isArray(source)) {
+      const length = Math.min(source.length, maxRows + 1);
+      for (let index = 0; index < length; index += 1) keys.push(String(index));
+    } else {
+      for (const key in source) {
+        if (!Object.prototype.hasOwnProperty.call(source, key)) continue;
+        keys.push(key);
+        if (keys.length > maxRows) break;
+      }
+    }
+    const rows: PpDraftRow[] = [];
+    const truncated = keys.length > maxRows;
+    let identifierGaps = 0;
+    const skippedPositions: number[] = [];
+    for (let index = 0; index < Math.min(keys.length, maxRows); index += 1) {
+      const key = keys[index];
+      if (key === undefined) {
+        skippedPositions.push(index);
+        continue;
+      }
+      const row = read(source, key);
+      if (!row.found || !row.value || typeof row.value !== 'object') {
+        skippedPositions.push(index);
+        continue;
+      }
+      const values = fieldValues(row.value, fields);
+      if (Object.keys(values).length === 0) {
+        skippedPositions.push(index);
+        continue;
+      }
+      if (identifierFields.some((field) => {
+        const value = read(row.value, field);
+        return !value.found || value.value === null || value.value === undefined || value.value === '';
+      })) identifierGaps += 1;
+      const translations: Record<string, PpDraftTranslation> = {};
+      for (const field of translatedFields) {
+        const value = read(row.value, field);
+        if (!value.found) continue;
+        translations[field] = translation(value.value);
+      }
+      rows.push({ position: index, values, translations });
+    }
+    return { state: 'available', rows, truncated, identifierGaps, skippedPositions };
+  };
+
+  try {
+    const requireFn = (window as Window & { require?: unknown }).require;
+    const contexts = read(requireFn, 's');
+    const context = path(contexts.value, ['contexts', '_']);
+    const defined = read(context.value, 'defined');
+    const registryModule = read(defined.value, registryModuleName);
+    const get = read(registryModule.value, 'get');
+    if (!contexts.found || !context.found || !defined.found || !registryModule.found || typeof get.value !== 'function') {
+      base.warnings.push('The already-loaded Magento registry is unavailable.');
+      return base;
+    }
+    const provider = (get.value as (name: string) => unknown).call(
+      registryModule.value,
+      providerName,
+    );
+    if (!provider) {
+      base.warnings.push('The Magento custom-option provider is not loaded.');
+      return base;
+    }
+    const dataRead = read(provider, 'data');
+    if (!dataRead.found || !dataRead.value || typeof dataRead.value !== 'object') {
+      base.warnings.push('The Magento provider data is unavailable.');
+      return base;
+    }
+    const data = dataRead.value;
+    const providerId = read(data, 'attributesetcustomoptions_id');
+    if (providerId.found) base.providerEntityId = safeValue(providerId.value);
+    if (providerId.found && String(providerId.value) !== entityId) {
+      base.status = 'identity-mismatch';
+      base.warnings.push('The route entity and provider entity do not match.');
+      return base;
+    }
+
+    const general = path(data, ['general']);
+    const generalValid = general.found && !!general.value && typeof general.value === 'object';
+    if (generalValid) {
+      base.general = fieldValues(general.value, [
+        'option_title', 'attribute_set_id', 'option_type', 'is_required',
+        'sort_order', 'description', 'info_message', 'placeholder', 'price',
+        'max_characters', 'allowed_extensions', 'translationsData', 'translations',
+      ]);
+      const translations = read(general.value, 'translationsData');
+      if (translations.found) base.generalTranslations = translation(translations.value);
+      const setId = read(general.value, 'attribute_set_id');
+      if (setId.found) base.generalAttributeSetId = safeValue(setId.value);
+    } else {
+      base.warnings.push('General provider data is missing or invalid.');
+    }
+    const providerSetId = read(data, 'attribute_set_id');
+    if (providerSetId.found) base.providerAttributeSetId = safeValue(providerSetId.value);
+
+    const locationFields = [
+      'record_id', 'key_id', 'name', 'description', 'img', 'price', 'sort',
+      'store_view', 'visible', 'is_visible', 'hidden', 'disabled', 'delete',
+    ];
+    const itemFields = [
+      'record_id', 'parent', 'name', 'name_option', 'price', 'sort',
+      'store_view', 'visible', 'is_visible', 'hidden', 'disabled', 'delete',
+    ];
+    base.locations = collection(
+      path(data, ['options', 'sub_options', 'sub_options']),
+      locationFields,
+      ['name', 'description'],
+      ['record_id', 'key_id'],
+    );
+    base.items = collection(
+      path(data, ['options', 'sub_options_items', 'sub_options_items']),
+      itemFields,
+      ['name'],
+      ['record_id', 'parent'],
+    );
+    base.scannedAt = Date.now();
+    base.status = 'ok';
+    if (!generalValid || base.locations.state !== 'available' || base.items.state !== 'available') {
+      base.status = 'partial';
+      if (base.locations.state !== 'available') base.warnings.push(`Location collection is ${base.locations.state}.`);
+      if (base.items.state !== 'available') base.warnings.push(`Item collection is ${base.items.state}.`);
+    }
+    if (base.generalTranslations?.parseError) {
+      base.status = 'partial';
+      base.warnings.push(base.generalTranslations.parseError);
+    }
+    if ([...base.locations.rows, ...base.items.rows].some((row) =>
+      Object.values(row.translations).some((value) => Boolean(value.parseError)),
+    )) {
+      base.status = 'partial';
+      base.warnings.push('One or more row translation values contain invalid JSON.');
+    }
+    if (base.locations.identifierGaps || base.items.identifierGaps) {
+      base.status = 'partial';
+      base.warnings.push(
+        `Rows with missing or blank identity/parent fields: locations ${base.locations.identifierGaps}, items ${base.items.identifierGaps}.`,
+      );
+    }
+    if (base.locations.skippedPositions.length || base.items.skippedPositions.length) {
+      base.status = 'partial';
+      base.warnings.push(
+        `Unrecognized or invalid rows were skipped: locations [${base.locations.skippedPositions.join(', ')}], items [${base.items.skippedPositions.join(', ')}].`,
+      );
+    }
+    if (base.locations.truncated || base.items.truncated || clipped) {
+      base.status = 'partial';
+      base.warnings.push('The snapshot reached a safety limit; some values or rows may be truncated.');
+    }
+    if (sanitized) {
+      base.status = 'partial';
+      base.warnings.push('Some provider values were omitted or sanitized because they were not safe JSON values.');
+    }
+    const duplicateValues = (rows: PpDraftRow[], field: string): boolean => {
+      const seen = new Set<string>();
+      for (const row of rows) {
+        const value = row.values[field];
+        if (typeof value !== 'string' && typeof value !== 'number') continue;
+        const key = String(value);
+        if (seen.has(key)) return true;
+        seen.add(key);
+      }
+      return false;
+    };
+    if (
+      duplicateValues(base.locations.rows, 'record_id') ||
+      duplicateValues(base.locations.rows, 'key_id') ||
+      duplicateValues(base.items.rows, 'record_id')
+    ) {
+      base.status = 'partial';
+      base.warnings.push('Duplicate row identifiers were found; review relationships manually.');
+    }
+    base.warnings.push('Item parent values are preserved raw; this scan does not infer location assignments.');
+    base.warnings.push('Absent provider fields are omitted; explicit blank values remain visible as empty strings.');
+    return base;
+  } catch {
+    base.status = 'unavailable';
+    base.general = {};
+    base.locations = { state: 'missing', rows: [], truncated: false, identifierGaps: 0, skippedPositions: [] };
+    base.items = { state: 'missing', rows: [], truncated: false, identifierGaps: 0, skippedPositions: [] };
+    base.warnings.push('The provider could not be read safely. Retry the scan after Magento finishes loading.');
+    return base;
+  }
+}
diff --git a/src/shared/ppCatalog.ts b/src/shared/ppCatalog.ts
new file mode 100644
index 0000000..ee041e4
--- /dev/null
+++ b/src/shared/ppCatalog.ts
@@ -0,0 +1,38 @@
+import { z } from 'zod';
+
+export const PP_CATALOG_DATABASE = '417b6705-ae1f-81ba-bdfd-c46a86fe4b54';
+export const PP_CATALOG_DATA_SOURCE = '431b6705-ae1f-83db-b71c-0739778f9e1a';
+
+export const PpCatalogDefinitionSchema = z.object({
+  pageId: z.string().regex(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i),
+  code: z.string(),
+  name: z.string(),
+  reviewStatus: z.string().nullable(),
+  faces: z.array(z.string()).nullable(),
+  options: z.array(z.string()).nullable(),
+  techniques: z.array(z.string()).nullable(),
+  faceCount: z.number().nullable(),
+  locationCount: z.number().nullable(),
+  body: z.array(z.string()),
+  warnings: z.array(z.string()),
+  lastEditedAt: z.string().nullable(),
+});
+export type PpCatalogDefinition = z.infer<typeof PpCatalogDefinitionSchema>;
+
+export const PpCatalogResponseSchema = z.object({
+  status: z.enum(['found', 'not-found', 'multiple', 'auth', 'access', 'network', 'partial', 'unavailable', 'invalid']),
+  code: z.string(),
+  checkedAt: z.string(),
+  reason: z.string(),
+  definition: PpCatalogDefinitionSchema.optional(),
+}).refine(response => response.status !== 'found' || response.definition !== undefined);
+export type PpCatalogResponse = z.infer<typeof PpCatalogResponseSchema>;
+
+/** A supported edit record, never a storefront or create/duplicate route. */
+export function ppCatalogEntity(url: string): string | null {
+  try {
+    const parsed = new URL(url);
+    if (!/^https:\/\/(bestofgifts\.(pt|eu|es|fr)|bestofgifts-pt-qa\.toogas\.net)$/.test(parsed.origin)) return null;
+    return parsed.pathname.match(/\/toogas_attributesetcustomoptions\/attributesetcustomoptions\/edit\/attributesetcustomoptions_id\/(\d+)(?:\/|$)/)?.[1] ?? null;
+  } catch { return null; }
+}
diff --git a/tests/ppCatalog.test.ts b/tests/ppCatalog.test.ts
new file mode 100644
index 0000000..3811b07
--- /dev/null
+++ b/tests/ppCatalog.test.ts
@@ -0,0 +1,174 @@
+import test, { type TestContext } from 'node:test';
+import assert from 'node:assert/strict';
+import { loadPpCatalog } from '../src/audit/ppCatalog';
+import { PP_CATALOG_DATABASE, PP_CATALOG_DATA_SOURCE } from '../src/shared/ppCatalog';
+
+const id = 'cbbb6705-ae1f-8227-90c6-01b6be542afc';
+const tableId = '11111111-1111-1111-1111-111111111111';
+const rich = (value: string) => [{ plain_text: value }];
+const options = (names: string[]) => ({ type: 'multi_select', multi_select: names.map(name => ({ name })) });
+const page = (code = '49') => ({ id, last_edited_time: '2026-11-13T10:00:00.000Z', properties: {
+  PP: { type: 'title', title: rich('49 - Textile') },
+  'Código PP': { type: 'rich_text', rich_text: rich(code) },
+  Estado: { type: 'select', select: { name: 'A rever' } },
+  Faces: options(['Face 1', 'Face 2', 'Face 3', 'Face 4', 'Face 5', 'Face 6']),
+  'Técnicas': options(['Screen print']), 'Opções de personalização': options(['1 colour']),
+  'Número de faces': { type: 'number', number: null },
+  'Número de locais possíveis': { type: 'number', number: 6 },
+} });
+let now = 1_800_000_000_000;
+
+async function settle<T>(t: TestContext, promise: Promise<T>): Promise<T> {
+  let done = false;
+  void promise.then(() => { done = true; }, () => { done = true; });
+  for (let i = 0; i < 500 && !done; i++) {
+    t.mock.timers.tick(500);
+    for (let j = 0; j < 24; j++) await Promise.resolve();
+  }
+  assert.ok(done, 'bounded lookup completed');
+  return promise;
+}
+
+function fixture(t: TestContext, config: {
+  code?: string; token?: string; rows?: readonly unknown[]; more?: boolean; schema?: string;
+  status?: number; network?: boolean; bodyStatus?: number; cappedBody?: boolean; malformed?: boolean; bodyBlocks?: unknown[];
+} = {}) {
+  t.mock.timers.enable({ apis: ['setTimeout', 'Date'], now: now += 2_000_000 });
+  const globals = globalThis as unknown as Record<string, unknown>;
+  const previousChrome = globals.chrome;
+  globals.chrome = { runtime: { id: 'fixture-only-extension' }, storage: { local: { get: async () => ({ notionToken: config.token ?? 'fixture-only-token' }) } } };
+  t.after(() => { globals.chrome = previousChrome; });
+  const calls: { url: string; method: string; body: Record<string, unknown> }[] = [];
+  t.mock.method(globalThis, 'fetch', async (input: unknown, init?: RequestInit) => {
+    const url = String(input);
+    const method = init?.method ?? 'GET';
+    calls.push({ url, method, body: init?.body ? JSON.parse(String(init.body)) as Record<string, unknown> : {} });
+    assert.ok(method === 'GET' || (method === 'POST' && url.endsWith(`/databases/${PP_CATALOG_DATABASE}/query`)), 'only catalogue reads');
+    assert.ok(!url.includes(PP_CATALOG_DATA_SOURCE), 'data source is not used as a legacy database id');
+    if (config.network) throw new TypeError('fixture network failure');
+    if (config.status) return Response.json({ code: 'fixture_error' }, { status: config.status });
+    if (url.endsWith(`/databases/${PP_CATALOG_DATABASE}`)) return Response.json({ properties: {
+      'Código PP': { type: config.schema ?? 'rich_text' }, PP: { type: 'title' },
+    } });
+    if (url.endsWith('/query')) return Response.json(config.malformed ? {} : {
+      results: config.rows ?? [page(config.code)], has_more: config.more ?? false, next_cursor: config.more ? 'next' : null,
+    });
+    if (config.bodyStatus) return Response.json({ code: 'restricted_resource' }, { status: config.bodyStatus });
+    if (config.bodyBlocks) return Response.json({ results: config.bodyBlocks, has_more: false });
+    if (config.cappedBody) return Response.json({ results: [], has_more: true, next_cursor: 'repeated' });
+    if (url.includes(`/blocks/${tableId}/children`)) return Response.json({ results: [{
+      type: 'table_row', table_row: { cells: [rich('Face 1 / Face 2'), rich('Distribution unconfirmed')] },
+    }], has_more: false });
+    const cursor = new URL(url).searchParams.get('start_cursor');
+    return Response.json(cursor ? { results: [{ type: 'paragraph', paragraph: { rich_text: rich('After table') } }], has_more: false }
+      : { results: [
+        { type: 'paragraph', paragraph: { rich_text: rich('Locais e personalização') } },
+        { id: tableId, type: 'table', table: {}, has_children: true },
+      ], has_more: true, next_cursor: 'body-next' });
+  });
+  return calls;
+}
+
+test('exact lookup uses schema, copied database and read-only body pagination; retains uncertainty and blank counts', async t => {
+  const calls = fixture(t);
+  const result = await settle(t, loadPpCatalog('49'));
+  assert.equal(result.status, 'found');
+  assert.equal(result.definition!.reviewStatus, 'A rever');
+  assert.equal(result.definition!.faceCount, null);
+  assert.equal(result.definition!.locationCount, 6);
+  assert.equal(result.definition!.faces!.length, 6);
+  assert.deepEqual(result.definition!.body, ['Locais e personalização', 'Face 1 / Face 2 | Distribution unconfirmed', 'After table']);
+  assert.equal('assignments' in result.definition!, false);
+  assert.match(result.definition!.warnings.join(' '), /do not establish assignments/);
+  assert.deepEqual(calls.find(call => call.method === 'POST')!.body, {
+    page_size: 2, filter: { property: 'Código PP', rich_text: { equals: '49' } },
+  });
+  assert.ok(!JSON.stringify(result).includes('fixture-only-token'));
+});
+
+test('code is kept verbatim without trimming, prefix or numeric aliases', async t => {
+  const calls = fixture(t, { code: ' 0049 ' });
+  const result = await settle(t, loadPpCatalog(' 0049 '));
+  assert.equal(result.definition!.code, ' 0049 ');
+  assert.deepEqual(calls.find(call => call.method === 'POST')!.body.filter,
+    { property: 'Código PP', rich_text: { equals: ' 0049 ' } });
+});
+
+for (const [index, scenario] of ([
+  { rows: [], expected: 'not-found' },
+  { rows: [page(), page()], expected: 'multiple' },
+  { rows: [page()], more: true, expected: 'partial' },
+  { rows: [page('PP49')], expected: 'partial' },
+  { schema: 'number', expected: 'unavailable' },
+  { malformed: true, expected: 'unavailable' },
+  { status: 401, expected: 'auth' },
+  { status: 403, expected: 'access' },
+  { status: 404, expected: 'access' },
+  { status: 400, expected: 'unavailable' },
+  { network: true, expected: 'network' },
+] as const).entries()) {
+  test(`lookup case ${index + 1}: ${scenario.expected}, no reference selected`, async t => {
+    const calls = fixture(t, scenario);
+    const result = await settle(t, loadPpCatalog('49'));
+    assert.equal(result.status, scenario.expected);
+    assert.equal(result.definition, undefined);
+    assert.equal(calls.some(call => call.url.includes('/blocks/')), false);
+  });
+}
+
+test('missing credentials and invalid input make no network requests', async t => {
+  const calls = fixture(t, { token: '' });
+  assert.equal((await loadPpCatalog('49')).status, 'auth');
+  for (const code of [49, '', '   ', 'x'.repeat(129), null]) assert.equal((await loadPpCatalog(code)).status, 'invalid');
+  assert.deepEqual(calls, []);
+});
+
+test('partial body coverage is explicit, with verified properties retained', async t => {
+  const calls = fixture(t, { cappedBody: true });
+  const result = await settle(t, loadPpCatalog('49'));
+  assert.equal(result.status, 'partial');
+  assert.equal(result.definition!.code, '49');
+  assert.match(result.definition!.warnings.join(' '), /coverage limit/);
+  assert.ok(calls.filter(call => call.url.includes('/blocks/')).length <= 8);
+});
+
+test('body access failure retains the reference but never reports full success', async t => {
+  fixture(t, { bodyStatus: 403 });
+  const result = await settle(t, loadPpCatalog('49'));
+  assert.equal(result.status, 'access');
+  assert.equal(result.definition!.code, '49');
+  assert.deepEqual(result.definition!.body, []);
+});
+
+for (const supported of [true, false]) {
+  test(`Audit router only reads the catalogue for a supported sender (${supported})`, async t => {
+    const calls = fixture(t);
+    const chrome = (globalThis as unknown as { chrome: Record<string, unknown> }).chrome;
+    chrome.tabs = { get: async () => ({ url: supported
+      ? 'https://bestofgifts.pt/admin/toogas_attributesetcustomoptions/attributesetcustomoptions/edit/attributesetcustomoptions_id/966/'
+      : 'https://bestofgifts.pt/a-product.html' }) };
+    const { handleAuditMessage } = await import('../src/entrypoints/background/routers/audit');
+    const response = new Promise<unknown>(resolve => {
+      assert.equal(handleAuditMessage({ type: 'FETCH_PP_CATALOG', code: '49' }, { senderTabId: 7, sendResponse: resolve }), true);
+    });
+    const result = await settle(t, response) as { status: string };
+    assert.equal(result.status, supported ? 'found' : 'unavailable');
+    assert.equal(calls.length > 0, supported);
+  });
+}
+
+for (const [block, expected] of [
+  [{ type: 'unsupported', unsupported: {}, has_children: false }, 'partial'],
+  [{ type: 'paragraph', paragraph: {}, has_children: false }, 'partial'],
+  [{ type: 'divider', divider: {}, has_children: false }, 'found'],
+] as const) {
+  test(`body coverage: ${block.type} is ${expected}, with readable text retained`, async t => {
+    fixture(t, { bodyBlocks: [
+      { type: 'paragraph', paragraph: { rich_text: rich('Readable source paragraph') } }, block,
+    ] });
+    const result = await settle(t, loadPpCatalog('49'));
+    assert.equal(result.status, expected);
+    assert.deepEqual(result.definition!.body, ['Readable source paragraph']);
+    assert.equal(result.definition!.warnings.some(warning => /coverage limit/.test(warning)), expected === 'partial');
+  });
+}
