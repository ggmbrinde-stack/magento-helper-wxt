{
  "name": "magento-helper-wxt",
  "version": "0.2.1",
  "private": true,
  "description": "Magento Helper extension on the plan stack (TypeScript strict, WXT, Zod). Migration target; sku-copy-button/ stays the working extension.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip -b chrome",
    "prezip": "npm run prebuild",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/sync-toolkit.mjs --check && node scripts/check-lanes.mjs && node scripts/check-features.mjs",
    "prebuild": "node scripts/sync-toolkit.mjs --check && node scripts/check-lanes.mjs && node scripts/check-features.mjs",
    "pretypecheck": "node scripts/sync-toolkit.mjs --check && node scripts/check-lanes.mjs && node scripts/check-features.mjs",
    "ui:sync": "node scripts/sync-toolkit.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:lanes": "node scripts/check-lanes.mjs",
    "check:features": "node scripts/check-features.mjs",
    "check:notion": "node scripts/check-notion-readonly.mjs",
    "test:supplier": "npx esbuild src/audit/__tests__/supplier.test.ts --bundle --platform=node --format=esm --loader:.json=json --external:node:test --outfile=.output/supplier-test.mjs --log-level=warning && node --test .output/supplier-test.mjs",
    "index:build": "node scripts/build-category-index.mjs",
    "diag:badges": "node scripts/diag-category-badges.mjs",
    "audit:badges": "node scripts/audit-category-badges.mjs",
    "cat:check": "node scripts/check-categories-live.mjs",
    "test:makito": "npx esbuild src/audit/__tests__/makitoImages.test.ts --bundle --platform=node --format=esm --loader:.json=json --external:node:test --outfile=.output/makito-images-test.mjs --log-level=warning && node --test .output/makito-images-test.mjs",
    "test:enable": "npx esbuild src/audit/__tests__/enableFlow.test.ts --bundle --platform=node --format=esm --loader:.json=json --external:node:test --outfile=.output/enable-flow-test.mjs --log-level=warning && node --test .output/enable-flow-test.mjs",
    "test:facts": "npx esbuild src/audit/__tests__/adminFacts.test.ts --bundle --platform=node --format=esm --loader:.json=json --external:node:test --outfile=.output/admin-facts-test.mjs --log-level=warning && node --test .output/admin-facts-test.mjs",
    "test": "npm run test:supplier && npm run test:makito && npm run test:enable && npm run test:facts && npm run test:attribute-set && npm run test:features",
    "test:features": "npx esbuild src/shared/__tests__/features.test.ts --bundle --platform=node --format=esm --external:node:test --external:jsdom --outfile=.output/features-test.mjs --log-level=warning && node --test .output/features-test.mjs",
    "test:attribute-set": "npx esbuild src/audit/__tests__/attributeSet.test.ts --bundle --platform=node --format=esm --loader:.json=json --external:node:test --external:jsdom --outfile=.output/attribute-set-test.mjs --log-level=warning && node --test .output/attribute-set-test.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jsdom": "^24.0.0",
    "typescript": "^5.6.3",
    "wxt": "^0.19.9"
  }
}
