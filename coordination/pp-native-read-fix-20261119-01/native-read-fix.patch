+            or datetime.fromisoformat(expiry.replace('Z', '+00:00')).tzinfo is None):
+        raise ValueError('Invalid hosted-file expiry metadata')
+    value['file'] = {'url': FILE_LOCATOR + hashlib.sha256(locator.encode('utf-8')).hexdigest()}
+    return value
